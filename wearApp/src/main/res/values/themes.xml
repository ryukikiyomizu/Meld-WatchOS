<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose owns the visual design; this theme only has to keep the window black and chrome-free
      so the app doesn't flash a white background (or a title bar) before the first frame.
      On a round AMOLED watch a black window also means a truly black bezel.
    -->
    <style name="Theme.MeldWear" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
